---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "¿Tienes dudas o te interesa una propiedad?", 
  subtitle = "Déjanos tus datos y te responderemos por WhatsApp a la brevedad."
} = Astro.props;
---

<div class="contact-box">
  <h3>{title}</h3>
  <p>{subtitle}</p>
  
  <form class="contact-form" id="propertyContactForm">
    <div class="form-group">
      <label for="name">Nombre <span class="optional">(opcional)</span></label>
      <input type="text" id="name" placeholder="Ej. Juan Pérez" />
    </div>
    
    <div class="form-group">
      <label for="email">Correo electrónico <span class="optional">(opcional)</span></label>
      <input type="email" id="email" placeholder="juan@ejemplo.com" />
    </div>
    
    <div class="form-group">
      <label for="phone">Teléfono <span class="optional">(opcional)</span></label>
      <input type="tel" id="phone" placeholder="+56 9 1234 5678" />
    </div>
    
    <div class="form-group">
      <label for="message">Mensaje <span class="required-mark">*</span></label>
      <textarea id="message" rows="4" required placeholder="Me gustaría agendar una visita / tengo una consulta..."></textarea>
    </div>
    
    <button type="submit" class="btn btn-primary w-full whatsapp-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: middle;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      Enviar por WhatsApp
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('propertyContactForm') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
      const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();
      
      const pageUrl = window.location.href;
      
      // Construir el mensaje solo con los campos que se completaron
      let wpMessage = `Hola MACG Propiedades!\n\nMe contacto desde:\n${pageUrl}\n\n`;
      if (name)  wpMessage += `Nombre: ${name}\n`;
      if (email) wpMessage += `Email: ${email}\n`;
      if (phone) wpMessage += `Teléfono: ${phone}\n`;
      wpMessage += `\nMensaje:\n${message}`;
      
      const whatsappNumber = "56945745838"; 
      const wpUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(wpMessage)}`;
      
      window.open(wpUrl, '_blank');
      form.reset();
    });
  }
</script>

<style>
  .contact-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 100px;
  }

  h3 {
    margin-bottom: var(--space-2);
    font-size: 1.25rem;
  }

  p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-6);
  }

  .form-group {
    margin-bottom: var(--space-4);
  }

  label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-main);
  }

  .optional {
    font-weight: 400;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .required-mark {
    color: var(--color-accent);
  }

  input, textarea {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: #f8fafc;
    transition: all var(--transition-fast);
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background-color: var(--color-surface);
    box-shadow: 0 0 0 3px var(--color-accent-light);
  }

  .w-full {
    width: 100%;
  }

  .whatsapp-btn {
    border: none;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .whatsapp-btn:hover {
    transform: translateY(-2px);
  }
</style>
