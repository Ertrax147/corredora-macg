---
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="contacto">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="logo">
        <img src="/logo.jpeg" alt="Logo" class="logo-img" onerror="this.style.display='none'" />
        <div class="logo-text-container">
          <span class="logo-text">MACG</span>
          <span class="logo-subtext">Propiedades</span>
        </div>
      </div>
      <p class="footer-desc">
        Expertos en arriendo y venta de propiedades, ofreciendo seguridad y confianza en cada transacción.
      </p>
    </div>
    
    <div class="footer-links">
      <h3 class="footer-title">Enlaces Rápidos</h3>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/propiedades">Catálogo de Propiedades</a></li>
        <li><a href="/seguros">Seguros y Garantías</a></li>
      </ul>
    </div>
    
    <div class="footer-contact">
      <h3 class="footer-title">Contacto</h3>
      <p><strong>Email:</strong> mercedes.calderon@macg.cl</p>
      <p><strong>Teléfono:</strong> +569 45745838</p>
      <p><strong>Dirección:</strong> Camilo Henriquez 430 Oficina 1A, Villarrica, Chile</p>
      <div class="social-links" style="margin-top: var(--space-4); display: flex; gap: var(--space-4);">
        <a href="https://www.instagram.com/corredoramacg/" target="_blank" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://www.facebook.com/p/Corredora-MACG-100066473784998/" target="_blank" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://www.tiktok.com/@macg.propiedades" target="_blank" aria-label="TikTok">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5v3a8 8 0 0 1-8-8h-3v11.5a1.5 1.5 0 1 1-1.5-1.5V9a4 4 0 1 0 4 4z"></path></svg>
        </a>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom container">
    <p>&copy; {currentYear} MACG Propiedades. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary-dark);
    color: var(--color-surface);
    padding-top: var(--space-12);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo-text-container {
    display: flex;
    flex-direction: column;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-surface);
    line-height: 1;
  }

  .logo-subtext {
    font-size: 0.75rem;
    color: var(--color-secondary-light);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .logo-img {
    height: 60px;
    width: auto;
    object-fit: contain;
  }

  .footer-desc {
    margin-top: var(--space-4);
    color: var(--color-secondary-light);
  }

  .footer-title {
    color: var(--color-surface);
    margin-bottom: var(--space-4);
    font-size: 1.125rem;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: var(--space-2);
  }

  .footer-links a {
    color: var(--color-secondary-light);
  }

  .footer-links a:hover {
    color: var(--color-accent-light);
  }

  .footer-contact p {
    color: var(--color-secondary-light);
    margin-bottom: var(--space-2);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: var(--space-4) 0;
    text-align: center;
    color: var(--color-secondary-light);
    font-size: 0.875rem;
  }

  .social-links a {
    color: var(--color-surface);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .social-links a:hover {
    color: var(--color-accent-light);
    transform: translateY(-2px);
  }
</style>
