---
import Layout from '../layouts/Layout.astro';

const insurances = [
  {
    title: "Seguro de Casas",
    description: "Protege tu hogar frente a incendios, sismos, robos y otros imprevistos. Cobertura completa para tu tranquilidad y la de tu familia.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`
  },
  {
    title: "Seguro de Autos",
    description: "Cobertura total o por pérdida parcial, asistencia en ruta y daños a terceros. Protegemos tu vehículo donde quiera que vayas.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="10" width="20" height="10" rx="2"></rect><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"></path><circle cx="6" cy="16" r="2"></circle><circle cx="18" cy="16" r="2"></circle></svg>`
  },
  {
    title: "Protección Pyme",
    description: "Seguros diseñados para empresas y locales comerciales. Cobertura de responsabilidad civil, incendios y protección de inventario.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  {
    title: "Vida y Salud",
    description: "Cuidamos lo más valioso: tú y tu familia. Coberturas médicas y seguros de vida para respaldar el futuro de los que amas.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`
  }
];
---

<Layout title="Seguros Inmobiliarios">
  <div class="insurance-hero">
    <div class="container">
      <h1>Protección y Tranquilidad</h1>
      <p>En MACG no solo encontramos tu propiedad ideal, también nos aseguramos de protegerla.</p>
    </div>
  </div>

  <section class="container section">
    <div class="intro-text">
      <h2>Soluciones de Seguros a tu Medida</h2>
      <p>Entendemos que una propiedad es una de las inversiones más importantes de tu vida. Por eso, ofrecemos una gama completa de seguros diseñados específicamente para las necesidades de propietarios y arrendatarios en Chile.</p>
    </div>

    <div class="insurance-grid">
      {insurances.map(insurance => (
        <div class="insurance-card">
          <div class="icon-wrapper" set:html={insurance.icon} />
          <h3>{insurance.title}</h3>
          <p>{insurance.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-content">
      <h2>¿Necesitas asesoría sobre seguros?</h2>
      <p>Nuestros ejecutivos expertos están listos para ayudarte a elegir la mejor cobertura para tu propiedad.</p>
      <a href="#contacto" class="btn btn-primary btn-lg">Solicitar Asesoría</a>
    </div>
  </section>
</Layout>

<style>
  .insurance-hero {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: white;
    padding: var(--space-16) 0;
    text-align: center;
  }

  .insurance-hero h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }

  .insurance-hero p {
    font-size: 1.25rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .insurance-hero h1 {
      font-size: 3.5rem;
    }
  }

  .section {
    padding: var(--space-16) 0;
  }

  .intro-text {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-12);
  }

  .intro-text h2 {
    font-size: 2rem;
    margin-bottom: var(--space-4);
  }

  .intro-text p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .insurance-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .insurance-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .insurance-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .insurance-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    margin-bottom: var(--space-6);
  }

  .insurance-card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }

  .insurance-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .cta-section {
    background-color: var(--color-background);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: 2rem;
    margin-bottom: var(--space-4);
  }

  .cta-content p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: var(--space-8);
  }

  .btn-lg {
    padding: var(--space-3) var(--space-8);
    font-size: 1.125rem;
  }
</style>
