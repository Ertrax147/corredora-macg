---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const insurances = [
  {
    title: "Seguro de Casas",
    description: "Protege tu hogar frente a incendios, sismos, robos y otros imprevistos. Cobertura completa para tu tranquilidad y la de tu familia.",
    image: "https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&q=80&w=600"
  },
  {
    title: "Seguro de Autos",
    description: "Cobertura total o por p\u00e9rdida parcial, asistencia en ruta y da\u00f1os a terceros. Protegemos tu veh\u00edculo donde quiera que vayas.",
    image: "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=600"
  },
  {
    title: "Protecci\u00f3n Pyme",
    description: "Seguros dise\u00f1ados para empresas y locales comerciales. Cobertura de responsabilidad civil, incendios y protecci\u00f3n de inventario.",
    image: "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=600"
  },
  {
    title: "Vida y Salud",
    description: "Cuidamos lo m\u00e1s valioso: t\u00fa y tu familia. Coberturas m\u00e9dicas y seguros de vida para respaldar el futuro de los que amas.",
    image: "https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&q=80&w=600"
  }
];
---

<Layout title="Seguros Inmobiliarios">
  <div class="insurance-hero">
    <div class="container">
      <h1>Protección y Tranquilidad</h1>
      <p>En MACG no solo encontramos tu propiedad ideal, también nos aseguramos de protegerla.</p>
    </div>
  </div>

  <section class="container section">
    <div class="intro-text">
      <h2>Soluciones de Seguros a tu Medida</h2>
      <p>Entendemos que una propiedad es una de las inversiones más importantes de tu vida. Por eso, ofrecemos una gama completa de seguros diseñados específicamente para las necesidades de propietarios y arrendatarios en Chile.</p>
    </div>

    <div class="insurance-grid">
      {insurances.map(insurance => (
        <div class="insurance-card">
          <div class="card-image-wrapper">
            <img src={insurance.image} alt={insurance.title} loading="lazy" />
          </div>
          <div class="card-body">
            <h3>{insurance.title}</h3>
            <p>{insurance.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-content">
      <h2>¿Necesitas asesoría sobre seguros?</h2>
      <p>Nuestros ejecutivos expertos están listos para ayudarte a elegir la mejor cobertura para tu propiedad.</p>
      <a href="#contacto" class="btn btn-primary btn-lg" id="cta-asesoria">Solicitar Asesoría</a>
    </div>
  </section>

  <!-- Sección Contacto -->
  <section class="contact-section" id="contacto">
    <div class="container">
      <div style="text-align:center; margin-bottom: var(--space-8);">
        <h2>Contáctanos</h2>
        <p style="color: var(--color-text-muted); font-size: 1.125rem;">Cuéntanos qué necesitas y te respondemos por WhatsApp a la brevedad.</p>
      </div>
      <div style="max-width: 500px; margin: 0 auto;">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .insurance-hero {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: white;
    padding: var(--space-16) 0;
    text-align: center;
  }

  .insurance-hero h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }

  .insurance-hero p {
    font-size: 1.25rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .insurance-hero h1 {
      font-size: 3.5rem;
    }
  }

  .section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .intro-text {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-12);
  }

  .intro-text h2 {
    font-size: 2rem;
    margin-bottom: var(--space-4);
  }

  .intro-text p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .insurance-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .insurance-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .insurance-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    text-align: left;
  }

  .insurance-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .card-image-wrapper {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .insurance-card:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .card-body {
    padding: var(--space-6);
  }

  .insurance-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
  }

  .insurance-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .cta-section {
    background-color: var(--color-background);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: 2rem;
    margin-bottom: var(--space-4);
  }

  .cta-content p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: var(--space-8);
  }

  .btn-lg {
    padding: var(--space-3) var(--space-8);
    font-size: 1.125rem;
  }

  .contact-section {
    padding: var(--space-16) var(--space-4);
    background-color: var(--color-surface);
  }
</style>
