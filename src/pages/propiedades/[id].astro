---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProperties = await getCollection('propiedades');
  return allProperties.map(prop => ({
    params: { id: prop.id },
    props: { prop },
  }));
}

const { prop } = Astro.props;
const { Content } = await render(prop);

const property = {
  id: prop.id,
  title: prop.data.title,
  type: prop.data.type,
  operation: prop.data.operation,
  price: prop.data.price,
  address: prop.data.address,
  bedrooms: prop.data.bedrooms,
  bathrooms: prop.data.bathrooms,
  area: prop.data.area,
  parking: 1, // Default por ahora
  storage: 1, // Default por ahora
  expenses: "$0", // Default
  images: prop.data.images && prop.data.images.length > 0 
    ? prop.data.images 
    : ["https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=1200"]
};
---

<Layout title={`${property.title} | ${property.operation}`}>
  <div class="property-detail-container container">
    <div class="detail-header">
      <a href="/propiedades" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Volver al catálogo
      </a>
      
      <div class="header-content">
        <div class="header-main">
          <div class="badges">
            <span class={`badge ${property.operation.toLowerCase()}`}>{property.operation}</span>
            <span class="badge type">{property.type}</span>
          </div>
          <h1>{property.title}</h1>
          <p class="address">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {property.address}
          </p>
        </div>
        <div class="header-price">
          <h2>{property.price}</h2>
          {property.operation === 'Arriendo' && <span class="expenses">Gastos Comunes: {property.expenses} aprox.</span>}
        </div>
      </div>
    </div>

    <div class="main-content">
      <div class="property-info">
        <!-- Gallery -->
        <div class="gallery">
          <img src={property.images[0]} alt={property.title} class="main-image" id="main-gallery-image" />
          <div class="thumbnail-grid">
            {property.images.map((img, index) => (
              <img src={img} alt="Vista adicional" class={`thumbnail ${index === 0 ? 'active' : ''}`} data-image={img} />
            ))}
          </div>
        </div>

        <script>
          const thumbnails = document.querySelectorAll('.thumbnail');
          const mainImage = document.getElementById('main-gallery-image');

          thumbnails.forEach(thumbnail => {
            thumbnail.addEventListener('click', function() {
              // Cambiar imagen principal
              const newSrc = this.getAttribute('data-image');
              if(mainImage) mainImage.setAttribute('src', newSrc);
              
              // Actualizar clase activa
              thumbnails.forEach(t => t.classList.remove('active'));
              this.classList.add('active');
            });
          });
        </script>

        <!-- Key Features -->
        <div class="features-grid">
          <div class="feature-item">
            <span class="feature-label">Superficie Total</span>
            <span class="feature-value">{property.area} m²</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Dormitorios</span>
            <span class="feature-value">{property.bedrooms}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Baños</span>
            <span class="feature-value">{property.bathrooms}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Estacionamientos</span>
            <span class="feature-value">{property.parking}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Bodegas</span>
            <span class="feature-value">{property.storage}</span>
          </div>
        </div>

        <!-- Description -->
        <div class="description-section">
          <h3>Descripción</h3>
          <div class="description-content">
            <Content />
          </div>
        </div>

        <!-- Map Placeholder -->
        <div class="map-section">
          <h3>Ubicación</h3>
          <div class="map-placeholder">
            <p>Mapa referencial de ubicación</p>
            <span>{property.address}</span>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="property-sidebar">
        <ContactForm />
      </aside>
    </div>
  </div>
</Layout>

<style>
  .property-detail-container {
    padding: var(--space-8) var(--space-4);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .detail-header {
    margin-bottom: var(--space-8);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .header-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .header-main h1 {
    font-size: 2rem;
    margin: var(--space-2) 0;
  }

  @media (min-width: 768px) {
    .header-main h1 {
      font-size: 2.5rem;
    }
  }

  .address {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .badge {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: white;
  }

  .badge.arriendo { background-color: var(--color-accent); }
  .badge.venta { background-color: var(--color-success); }
  .badge.type { background-color: var(--color-primary-dark); }

  .header-price {
    text-align: left;
  }

  @media (min-width: 768px) {
    .header-price {
      text-align: right;
    }
  }

  .header-price h2 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin: 0;
  }

  .expenses {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: var(--space-1);
  }

  .main-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .main-content {
      grid-template-columns: 2fr 1fr;
    }
  }

  .gallery {
    margin-bottom: var(--space-8);
  }

  .main-image {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-4);
  }

  .thumbnail {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .thumbnail:hover {
    opacity: 0.8;
  }

  .thumbnail.active {
    border: 3px solid var(--color-primary);
    opacity: 1;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .feature-label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .feature-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .description-section, .map-section {
    margin-bottom: var(--space-8);
  }

  h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .description-content {
    color: var(--color-text-main);
    line-height: 1.7;
  }

  .map-placeholder {
    background-color: var(--color-background);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }
</style>
