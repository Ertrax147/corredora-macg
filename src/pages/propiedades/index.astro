---
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import { sanityClient } from 'sanity:client';
import type { Propiedad } from '../../types';

const url = new URL(Astro.request.url);
const searchParams = url.searchParams;

const filterOp = searchParams.get('operation') || '';
const filterType = searchParams.get('type') || '';
const filterBeds = searchParams.get('bedrooms') || '';
const filterLoc = searchParams.get('location') || '';
const sortBy = searchParams.get('sort') || 'recent';

// Paginación
const page = parseInt(searchParams.get('page') || '1') || 1;
const ITEMS_PER_PAGE = 10;
const start = (page - 1) * ITEMS_PER_PAGE;
const end = start + ITEMS_PER_PAGE;

let filterQuery = `*[_type == "propiedad"`;

if (filterOp) filterQuery += ` && operation == "${filterOp}"`;
if (filterType) filterQuery += ` && type == "${filterType}"`;
if (filterLoc) filterQuery += ` && address == "${filterLoc}"`;
if (filterBeds) {
  const num = parseInt(filterBeds);
  if (!isNaN(num)) filterQuery += ` && bedrooms >= ${num}`;
}
filterQuery += `]`;

let sortQuery = ``;
if (sortBy === 'price-asc') sortQuery = ` | order(price asc)`;
else if (sortBy === 'price-desc') sortQuery = ` | order(price desc)`;
else sortQuery = ` | order(_createdAt desc)`;

const combinedQuery = `{
  "items": ${filterQuery}${sortQuery}[${start}...${end}] {
    "slug": slug.current,
    title,
    type,
    operation,
    price,
    address,
    bedrooms,
    bathrooms,
    area,
    "imageUrl": images[0].asset->url
  },
  "total": count(${filterQuery})
}`;

let properties: Propiedad[] = [];
let totalItems = 0;
let totalPages = 1;
let uniqueLocations: string[] = [];

try {
  const result = await sanityClient.fetch<{ items: Propiedad[], total: number }>(combinedQuery);
  totalItems = result.total;
  totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

  properties = result.items.map(prop => ({
    ...prop,
    imageUrl: prop.imageUrl ? `${prop.imageUrl}?auto=format&w=500&q=60` : null
  }));

  const rawLocations = await sanityClient.fetch<string[]>(`*[_type == "propiedad" && defined(address)].address`);
  uniqueLocations = [...new Set(rawLocations)].sort();
} catch (error) {
  console.error("Error fetching data from Sanity:", error);
}

function getPageUrl(p: number) {
  const u = new URL(Astro.request.url);
  u.searchParams.set('page', p.toString());
  return u.toString();
}
---

<Layout title="Catálogo de Propiedades">
  <div class="page-header fade-in">
    <div class="container">
      <h1 class="fade-up">Propiedades en Arriendo y Venta</h1>
      <p class="fade-up" style="transition-delay: 0.1s;">Encuentra el lugar perfecto para ti, filtrando según tus necesidades.</p>
    </div>
  </div>

  <div class="container catalog-container fade-in">
    <!-- Botón toggle solo en móvil -->
    <button class="filter-toggle-btn" id="filterToggle" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
      Filtrar propiedades
    </button>

    <aside class="filters-sidebar" id="filtersSidebar">
      <div class="filters-card">
        <h3>Filtros de Búsqueda</h3>
        <form id="catalogFilters" class="filters-form" method="GET" action="/propiedades">
          <div class="filter-group">
            <label for="f-op">Operación</label>
            <select id="f-op" name="operation">
              <option value="" selected={filterOp === ''}>Todas</option>
              <option value="Arriendo" selected={filterOp === 'Arriendo'}>Arriendo</option>
              <option value="Venta" selected={filterOp === 'Venta'}>Venta</option>
            </select>
          </div>
          
          <div class="filter-group">
            <label for="f-type">Tipo</label>
            <select id="f-type" name="type">
              <option value="" selected={filterType === ''}>Todos</option>
              <option value="Departamento" selected={filterType === 'Departamento'}>Departamento</option>
              <option value="Casa" selected={filterType === 'Casa'}>Casa</option>
              <option value="Oficina" selected={filterType === 'Oficina'}>Oficina</option>
              <option value="Parcela" selected={filterType === 'Parcela'}>Parcela</option>
            </select>
          </div>

          <div class="filter-group">
            <label for="f-loc">Ubicación</label>
            <select id="f-loc" name="location">
              <option value="" selected={filterLoc === ''}>Todas</option>
              {uniqueLocations.map((loc: string) => (
                <option value={loc} selected={filterLoc === loc}>{loc}</option>
              ))}
            </select>
          </div>

          <div class="filter-group">
            <label>Dormitorios</label>
            <input type="hidden" name="bedrooms" id="f-beds" value={filterBeds} />
            <div class="rooms-selector">
              <button type="button" class={`room-btn ${filterBeds === '' ? 'active' : ''}`} data-val="">Todos</button>
              <button type="button" class={`room-btn ${filterBeds === '1' ? 'active' : ''}`} data-val="1">1+</button>
              <button type="button" class={`room-btn ${filterBeds === '2' ? 'active' : ''}`} data-val="2">2+</button>
              <button type="button" class={`room-btn ${filterBeds === '3' ? 'active' : ''}`} data-val="3">3+</button>
              <button type="button" class={`room-btn ${filterBeds === '4' ? 'active' : ''}`} data-val="4">4+</button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-full" style="margin-top: var(--space-4);">
            Aplicar Filtros
          </button>
        </form>
      </div>
    </aside>

    <div class="catalog-content fade-up" style="transition-delay: 0.2s;">
      <div class="results-info">
        <p>Mostrando <strong>{properties.length}</strong> propiedades</p>
        <div class="sort-by">
          <label for="sort">Ordenar por:</label>
          <select id="sort" form="catalogFilters" name="sort" onchange="document.getElementById('catalogFilters').submit()">
            <option value="recent" selected={sortBy === 'recent'}>Más recientes</option>
            <option value="price-asc" selected={sortBy === 'price-asc'}>Precio: Menor a Mayor</option>
            <option value="price-desc" selected={sortBy === 'price-desc'}>Precio: Mayor a Menor</option>
          </select>
        </div>
      </div>

      <div class="property-grid fade-in-stagger">
        {properties.map((prop) => (
          <PropertyCard 
            slug={prop.slug}
            title={prop.title}
            type={prop.type}
            operation={prop.operation}
            price={prop.price}
            address={prop.address}
            bedrooms={prop.bedrooms}
            bathrooms={prop.bathrooms}
            area={prop.area}
            imageUrl={prop.imageUrl || "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=800"}
          />
        ))}
      </div>

      <!-- Paginación -->
      {totalPages > 1 && (
        <div class="pagination">
          {page > 1 ? (
            <a href={getPageUrl(page - 1)} class="btn btn-outline">Anterior</a>
          ) : (
            <button class="btn btn-outline" disabled>Anterior</button>
          )}
          
          <span class="page-info">Página {page} de {totalPages}</span>

          {page < totalPages ? (
            <a href={getPageUrl(page + 1)} class="btn btn-outline">Siguiente</a>
          ) : (
            <button class="btn btn-outline" disabled>Siguiente</button>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Contact Section -->
  <section id="contacto" class="contact-section" style="background-color: var(--color-surface); padding: var(--space-16) 0;">
    <div class="container">
      <div class="section-header fade-up" style="text-align: center; margin-bottom: var(--space-8);">
        <h2 class="section-title">Contáctanos</h2>
        <p class="section-subtitle">¿Tienes dudas sobre alguna propiedad o nuestros servicios? Escríbenos.</p>
      </div>
      
      <div class="contact-grid fade-up" style="display: grid; gap: var(--space-8); grid-template-columns: 1fr; max-width: 900px; margin: 0 auto;">
        <div class="contact-form-wrapper" style="margin: 0 auto; width: 100%; max-width: 500px;">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--color-primary-dark);
    color: var(--color-surface);
    padding: var(--space-12) 0;
    text-align: center;
  }

  .page-header h1 {
    color: var(--color-surface);
    margin-bottom: var(--space-4);
  }

  .page-header p {
    color: var(--color-secondary-light);
    font-size: 1.125rem;
  }

  .catalog-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-10) var(--space-4);
  }

  @media (min-width: 1024px) {
    .catalog-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  /* Paginación */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .pagination .btn {
    min-width: 100px;
  }

  .pagination button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: transparent;
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .page-info {
    font-weight: 500;
    color: var(--color-text-main);
  }

  @media (min-width: 1024px) {
    .catalog-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .filter-toggle-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 1024px) {
    .filter-toggle-btn {
      display: none;
    }
  }

  .filters-sidebar {
    width: 100%;
    display: none; /* hidden on mobile by default */
  }

  .filters-sidebar.open {
    display: block;
  }

  @media (min-width: 1024px) {
    .filters-sidebar {
      display: block; /* always visible on desktop */
      width: 300px;
      flex-shrink: 0;
      position: sticky;
      top: 100px;
    }
  }

  .filters-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .filters-card h3 {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .filters-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .filter-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: var(--space-2);
    color: var(--color-text-main);
  }

  .filter-group select {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .rooms-selector {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: var(--space-2);
  }

  .room-btn {
    width: 100%;
    padding: var(--space-2) 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .room-btn:hover {
    border-color: var(--color-primary);
  }

  .room-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .catalog-content {
    flex: 1;
  }

  .results-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .results-info {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .sort-by {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sort-by label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .sort-by select {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
  }

  .property-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .property-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .w-full {
    width: 100%;
  }
</style>

<script>
  // Lógica para el selector de dormitorios
  const roomBtns = document.querySelectorAll('.room-btn');
  const bedsInput = document.getElementById('f-beds') as HTMLInputElement;
  const form = document.getElementById('catalogFilters') as HTMLFormElement;

  roomBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      roomBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      bedsInput.value = btn.getAttribute('data-val') || '';
    });
  });

  // Toggle de filtros en móvil
  const filterToggle = document.getElementById('filterToggle');
  const filtersSidebar = document.getElementById('filtersSidebar');

  if (filterToggle && filtersSidebar) {
    filterToggle.addEventListener('click', () => {
      const isOpen = filtersSidebar.classList.toggle('open');
      filterToggle.setAttribute('aria-expanded', String(isOpen));
      filterToggle.textContent = isOpen ? '✕ Cerrar filtros' : '⚙ Filtrar propiedades';
    });
  }
</script>
