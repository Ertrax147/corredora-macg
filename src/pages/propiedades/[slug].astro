---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from '@portabletext/react';

const { slug } = Astro.params;

const prop = await sanityClient.fetch(`*[_type == "propiedad" && slug.current == $slug][0] {
  _id,
  title,
  type,
  operation,
  price,
  address,
  bedrooms,
  bathrooms,
  area,
  description,
  videoUrl,
  parking,
  storage,
  "images": images[].asset->url
}`, { slug });

if (!prop) {
  return Astro.redirect('/propiedades');
}

// Función para extraer la miniatura real del video
function getVideoThumbnailUrl(url: string | null): string | null {
  if (!url) return null;
  // YouTube
  const ytMatch = url.match(/(?:youtu\.be\/|v\/|embed\/|watch\?v=|&v=)([^#&?]{11})/);
  if (ytMatch) {
    return `https://img.youtube.com/vi/${ytMatch[1]}/hqdefault.jpg`;
  }
  // Google Drive
  const driveMatch = url.match(/\/d\/([a-zA-Z0-9_-]{25,})/);
  if (driveMatch) {
    return `https://drive.google.com/thumbnail?id=${driveMatch[1]}&sz=w800`;
  }
  return null; // Para TikTok, Instagram u otros no hay miniatura automática
}

const videoThumbnailUrl = getVideoThumbnailUrl(prop.videoUrl);

const property = {
  id: prop._id,
  title: prop.title,
  type: prop.type,
  operation: prop.operation,
  price: prop.price,
  address: prop.address,
  bedrooms: prop.bedrooms,
  bathrooms: prop.bathrooms,
  area: prop.area,
  parking: prop.parking || 0,
  storage: prop.storage || 0,
  images: prop.images && prop.images.length > 0 
    ? prop.images.map((url: string) => `${url}?auto=format&q=80&w=1200`)
    : ["https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=1200"],
  description: prop.description,
  videoUrl: prop.videoUrl
};
---

<Layout 
  title={`${property.title} | ${property.operation}`}
  description={`${property.operation} de ${property.type} en ${property.address}. ${property.bedrooms} Hab, ${property.bathrooms} Baños. Precio: ${property.price}. Superficie: ${property.area}m².`}
  image={property.images[0]}
>
  <div class="property-detail-container container">
    <div class="detail-header">
      <a href="/propiedades" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Volver al catálogo
      </a>
      
      <div class="header-content">
        <div class="header-main">
          <div class="badges">
            <span class={`badge ${property.operation.toLowerCase()}`}>{property.operation}</span>
            <span class="badge type">{property.type}</span>
          </div>
          <h1>{property.title}</h1>
          <p class="address">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {property.address}
          </p>
        </div>
        <div class="header-price">
          <h2>{property.price}</h2>
        </div>
      </div>
    </div>

    <div class="main-content">
      <div class="property-grid">
        <div class="property-info" style="min-width: 0;">
          <!-- Gallery -->
          <div class="gallery">
          <!-- Main display: image or video -->
          <div class="main-display-wrapper">
            <img src={property.images[0]} alt={property.title} class="main-image" id="main-gallery-image" />
            <div id="main-gallery-video" style="display:none;">
              {property.videoUrl && <VideoEmbed url={property.videoUrl} />}
            </div>
            <!-- Flechas de navegación (solo visibles cuando hay imagen activa) -->
            <button class="gallery-arrow gallery-arrow-prev" id="galleryPrev" aria-label="Foto anterior">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="gallery-arrow gallery-arrow-next" id="galleryNext" aria-label="Foto siguiente">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <!-- Contador de fotos -->
            <div class="gallery-counter" id="galleryCounter">1 / {property.images.length}</div>
            <!-- Botón pantalla completa -->
            <button class="fullscreen-btn" id="openLightbox" aria-label="Ver en pantalla completa">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
            </button>
          </div>

          <!-- Thumbnails: fila scrolleable horizontal -->
          <div class="thumbnail-row">
            {property.images.map((img: string, index: number) => (
              <img
                src={img}
                alt="Vista adicional"
                class={`thumbnail ${index === 0 ? 'active' : ''}`}
                data-type="image"
                data-image={img}
                data-index={index}
              />
            ))}
            {property.videoUrl && (
              <div class="thumbnail video-thumbnail" data-type="video">
                {videoThumbnailUrl
                  ? <img src={videoThumbnailUrl} alt="Miniatura de video" class="video-thumb-img" />
                  : <div class="video-thumb-placeholder"></div>
                }
                <div class="video-play-overlay">
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.5)" stroke="none"/><polygon points="10 8 16 12 10 16 10 8" fill="white"></polygon></svg>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Lightbox / Pantalla Completa -->
        <div id="lightbox" class="lightbox">
          <button class="lightbox-close" id="closeLightbox">&times;</button>
          <img id="lightboxImage" src="" alt="Vista ampliada" />
        </div>

        <script>
          const allThumbs  = Array.from(document.querySelectorAll('.thumbnail')) as HTMLElement[];
          const imageThumbs = allThumbs.filter(t => t.dataset.type === 'image');
          const mainImage  = document.getElementById('main-gallery-image') as HTMLImageElement | null;
          const mainVideo  = document.getElementById('main-gallery-video') as HTMLElement | null;
          const prevBtn    = document.getElementById('galleryPrev') as HTMLButtonElement | null;
          const nextBtn    = document.getElementById('galleryNext') as HTMLButtonElement | null;
          const counter    = document.getElementById('galleryCounter') as HTMLElement | null;

          let currentIndex = 0;

          function goToMedia(index: number) {
            if (!allThumbs.length) return;
            currentIndex = ((index % allThumbs.length) + allThumbs.length) % allThumbs.length;
            const target = allThumbs[currentIndex];
            const row = target.parentElement;

            allThumbs.forEach(t => t.classList.remove('active'));
            target.classList.add('active');

            if (target.dataset.type === 'video') {
              // Mostrar video, ocultar imagen
              if (mainImage) mainImage.style.display = 'none';
              if (mainVideo) mainVideo.style.display = 'block';
              if (counter) counter.style.display = 'none';
              // En video podemos elegir ocultar flechas o dejarlas para salir del video
              if (prevBtn) prevBtn.style.display = 'flex';
              if (nextBtn) nextBtn.style.display = 'flex';
            } else {
              // Mostrar imagen, ocultar video
              if (mainImage) { 
                mainImage.src = target.dataset.image!; 
                mainImage.style.display = 'block'; 
              }
              if (mainVideo) mainVideo.style.display = 'none';
              
              if (counter) { 
                // Buscamos el índice real de la imagen entre las imágenes para el contador
                const imgIndex = imageThumbs.indexOf(target);
                counter.textContent = `${imgIndex + 1} / ${imageThumbs.length}`; 
                counter.style.display = 'block'; 
              }
              if (prevBtn) prevBtn.style.display = 'flex';
              if (nextBtn) nextBtn.style.display = 'flex';
            }
            
            // Scroll manual de la fila
            if (row) {
              const scrollTarget = target.offsetLeft - (row.clientWidth / 2) + (target.clientWidth / 2);
              row.scrollTo({ left: scrollTarget, behavior: 'smooth' });
            }
          }

          allThumbs.forEach((thumb, index) => {
            thumb.addEventListener('click', () => goToMedia(index));
          });

          prevBtn?.addEventListener('click', () => goToMedia(currentIndex - 1));
          nextBtn?.addEventListener('click', () => goToMedia(currentIndex + 1));

          // Lightbox Logic
          const lightbox = document.getElementById('lightbox');
          const lightboxImg = document.getElementById('lightboxImage') as HTMLImageElement;
          const openLightboxBtn = document.getElementById('openLightbox');
          const closeLightboxBtn = document.getElementById('closeLightbox');

          function openLightbox() {
            if (mainImage && lightbox && lightboxImg) {
              lightboxImg.src = mainImage.src;
              lightbox.classList.add('active');
              document.body.style.overflow = 'hidden'; // Bloquea scroll fondo
            }
          }

          function closeLightbox() {
            if (lightbox) {
              lightbox.classList.remove('active');
              document.body.style.overflow = ''; // Restaura scroll
            }
          }

          openLightboxBtn?.addEventListener('click', openLightbox);
          mainImage?.addEventListener('click', openLightbox);
          closeLightboxBtn?.addEventListener('click', closeLightbox);
          lightbox?.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
          });
        </script>

        <!-- Key Features -->
        <div class="features-grid">
          <div class="feature-item">
            <span class="feature-label">Superficie Total</span>
            <span class="feature-value">{property.area} m²</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Dormitorios</span>
            <span class="feature-value">{property.bedrooms}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Baños</span>
            <span class="feature-value">{property.bathrooms}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Estacionamientos</span>
            <span class="feature-value">{property.parking}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Bodegas</span>
            <span class="feature-value">{property.storage}</span>
          </div>
        </div>

        <!-- Description -->
        <div class="description-section">
          <h3>Descripción</h3>
          <div class="description-content">
            {property.description ? <PortableText value={property.description} /> : <p>Sin descripción.</p>}
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="property-sidebar">
        <ContactForm />
      </aside>
    </div>
  </div>
</Layout>

<style>
  .property-detail-container {
    padding: var(--space-6) var(--space-4);
    /* margin: auto y max-width: 1200px vienen de la clase .container */
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .detail-header {
    margin-bottom: var(--space-8);
  }

  /* Lightbox Styles */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 40px rgba(0,0,0,0.5);
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    background: none;
    border: none;
    color: white;
    font-size: 3rem;
    cursor: pointer;
    line-height: 1;
    padding: var(--space-2);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .header-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .header-main h1 {
    font-size: 2rem;
    margin: var(--space-2) 0;
  }

  @media (min-width: 768px) {
    .header-main h1 {
      font-size: 2.5rem;
    }
  }

  .address {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .badge {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: white;
  }

  .badge.arriendo { background-color: var(--color-accent); }
  .badge.venta { background-color: var(--color-success); }
  .badge.type { background-color: var(--color-primary-dark); }

  .header-price {
    text-align: left;
  }

  @media (min-width: 768px) {
    .header-price {
      text-align: right;
    }
  }

  .header-price h2 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin: 0;
  }

  .expenses {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: var(--space-1);
  }

  .property-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .property-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .gallery {
    margin-bottom: var(--space-8);
    width: 100%;
    max-width: 100%;
    overflow: visible; /* Las flechas están posicionadas relativamente a esto */
  }

  .main-display-wrapper {
    position: relative;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
    display: block;
    cursor: zoom-in;
  }

  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.45);
    color: white;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
    z-index: 10;
    backdrop-filter: blur(4px);
  }

  .gallery-arrow:hover {
    background: rgba(0, 0, 0, 0.7);
    transform: translateY(-50%) scale(1.1);
  }

  .gallery-arrow-prev { left: var(--space-3); }
  .gallery-arrow-next { right: var(--space-3); }

  .gallery-counter {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    background: rgba(0, 0, 0, 0.6);
    color: white;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
    z-index: 10;
  }

  .fullscreen-btn {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    z-index: 10;
    transition: background var(--transition-fast);
  }

  .fullscreen-btn:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  /* ── Thumbnail row ── */
  .thumbnail-row {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-2); /* espacio para scrollbar en desktop */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    max-width: 100%;
  }

  .thumbnail {
    flex: 0 0 22%;   /* ~4 visibles en desktop */
    min-width: 80px;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-md);
    cursor: pointer;
    scroll-snap-align: start;
    transition: opacity var(--transition-fast), outline var(--transition-fast);
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  @media (max-width: 600px) {
    .thumbnail {
      flex: 0 0 38%; /* ~2.5 visibles en móvil */
    }
  }

  .thumbnail:hover { opacity: 0.8; }

  .thumbnail.active {
    outline-color: var(--color-accent);
    opacity: 1;
  }

  .video-thumbnail {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    cursor: pointer;
    flex: 0 0 22%;
    min-width: 80px;
    aspect-ratio: 4/3;
    scroll-snap-align: start;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  @media (max-width: 600px) {
    .video-thumbnail { flex: 0 0 38%; }
  }

  .video-thumbnail.active {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .video-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  }

  .video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    transition: background var(--transition-fast);
  }

  .video-thumbnail:hover .video-play-overlay { background: rgba(0, 0, 0, 0.35); }
  .video-thumbnail:hover { opacity: 0.9; transform: scale(1.03); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .feature-label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .feature-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .description-section, .map-section {
    margin-bottom: var(--space-8);
  }

  h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .description-content {
    color: var(--color-text-main);
    line-height: 1.7;
  }

  .map-placeholder {
    background-color: var(--color-background);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }
</style>
