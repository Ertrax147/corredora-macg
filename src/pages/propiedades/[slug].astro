---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from '@portabletext/react';

const { slug } = Astro.params;

const prop = await sanityClient.fetch(`*[_type == "propiedad" && slug.current == $slug][0] {
  _id,
  title,
  type,
  operation,
  price,
  address,
  bedrooms,
  bathrooms,
  area,
  description,
  videoUrl,
  parking,
  storage,
  "images": images[].asset->url
}`, { slug });

if (!prop) {
  return Astro.redirect('/propiedades');
}

// Función para extraer la miniatura real del video
function getVideoThumbnailUrl(url: string | null): string | null {
  if (!url) return null;
  // YouTube
  const ytMatch = url.match(/(?:youtu\.be\/|v\/|embed\/|watch\?v=|&v=)([^#&?]{11})/);
  if (ytMatch) {
    return `https://img.youtube.com/vi/${ytMatch[1]}/hqdefault.jpg`;
  }
  // Google Drive
  const driveMatch = url.match(/\/d\/([a-zA-Z0-9_-]{25,})/);
  if (driveMatch) {
    return `https://drive.google.com/thumbnail?id=${driveMatch[1]}&sz=w800`;
  }
  return null; // Para TikTok, Instagram u otros no hay miniatura automática
}

const videoThumbnailUrl = getVideoThumbnailUrl(prop.videoUrl);

const property = {
  id: prop._id,
  title: prop.title,
  type: prop.type,
  operation: prop.operation,
  price: prop.price,
  address: prop.address,
  bedrooms: prop.bedrooms,
  bathrooms: prop.bathrooms,
  area: prop.area,
  parking: prop.parking || 0,
  storage: prop.storage || 0,
  images: prop.images && prop.images.length > 0 
    ? prop.images.map((url: string) => `${url}?auto=format&q=80&w=1200`)
    : ["https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=1200"],
  description: prop.description,
  videoUrl: prop.videoUrl
};
---

<Layout 
  title={`${property.title} | ${property.operation}`}
  description={`${property.operation} de ${property.type} en ${property.address}. ${property.bedrooms} Hab, ${property.bathrooms} Baños. Precio: ${property.price}. ${property.area ? `Superficie: ${property.area}m².` : ''}`}
  image={property.images[0]}
>
  <div class="property-detail-container container">
    <div class="detail-header">
      <a href="/propiedades" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Volver al catálogo
      </a>
      
      <div class="header-content">
        <div class="header-main">
          <div class="badges">
            <span class={`badge ${property.operation.toLowerCase()}`}>{property.operation}</span>
            <span class="badge type">{property.type}</span>
          </div>
          <h1>{property.title}</h1>
          <p class="address">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {property.address}
          </p>
        </div>
        <div class="header-price">
          <h2>{property.price}</h2>
        </div>
      </div>
    </div>

    <div class="main-content">
      <div class="property-info">
        <!-- Gallery -->
        <image-gallery class="gallery">
          <!-- Main display: image or video -->
          <div class="main-display-wrapper">
            <div class="main-image-blur-bg" id="main-blur-bg" style={`background-image: url('${property.images[0]}')`}></div>
            <img src={property.images[0]} alt={property.title} class="main-image" id="main-gallery-image" />
            <div id="main-gallery-video" style="display:none;">
              {property.videoUrl && <VideoEmbed url={property.videoUrl} />}
            </div>
            <!-- Flechas de navegación (solo visibles cuando hay imagen activa) -->
            <button class="gallery-arrow gallery-arrow-prev" id="galleryPrev" aria-label="Foto anterior">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="gallery-arrow gallery-arrow-next" id="galleryNext" aria-label="Foto siguiente">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <!-- Contador de fotos -->
            <div class="gallery-counter" id="galleryCounter">1 / {property.images.length}</div>
            <!-- Botón de expandir (fullscreen) -->
            <button class="gallery-expand" id="galleryExpand" aria-label="Pantalla completa">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
              </svg>
            </button>
          </div>

          <!-- Thumbnails: fila scrolleable horizontal -->
          <div class="thumbnail-row">
            {property.images.map((img: string, index: number) => (
              <img
                src={img.replace('w=1200', 'w=300')}
                alt="Vista adicional"
                class={`thumbnail ${index === 0 ? 'active' : ''}`}
                data-type="image"
                data-image={img}
                data-index={index}
              />
            ))}
            {property.videoUrl && (
              <div class="thumbnail video-thumbnail" data-type="video">
                {videoThumbnailUrl
                  ? <img src={videoThumbnailUrl} alt="Miniatura de video" class="video-thumb-img" />
                  : <div class="video-thumb-placeholder"></div>
                }
                <div class="video-play-overlay">
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.5)" stroke="none"/><polygon points="10 8 16 12 10 16 10 8" fill="white"></polygon></svg>
                </div>
              </div>
            )}
          </div>
        </image-gallery>

        <script>
          class ImageGallery extends HTMLElement {
            constructor() {
              super();

              const allThumbs = Array.from(this.querySelectorAll('.thumbnail')) as HTMLElement[];
              const imageThumbs = allThumbs.filter(t => t.dataset.type === 'image');
              const mainImage = this.querySelector('#main-gallery-image') as HTMLImageElement | null;
              const mainBlurBg = this.querySelector('#main-blur-bg') as HTMLElement | null;
              const mainVideo = this.querySelector('#main-gallery-video') as HTMLElement | null;
              const prevBtn = this.querySelector('#galleryPrev') as HTMLButtonElement | null;
              const nextBtn = this.querySelector('#galleryNext') as HTMLButtonElement | null;
              const expandBtn = this.querySelector('#galleryExpand') as HTMLButtonElement | null;
              const counter = this.querySelector('#galleryCounter') as HTMLElement | null;

              let currentIndex = 0;
              let currentLoadId = 0;

              const goToImage = (index: number) => {
                if (!imageThumbs.length) return;
                currentIndex = ((index % imageThumbs.length) + imageThumbs.length) % imageThumbs.length;
                const target = imageThumbs[currentIndex] as HTMLImageElement;
                const thumbSrc = target.src;
                const fullSrc = target.dataset.image!;

                currentLoadId++;
                const loadId = currentLoadId;

                if (mainImage) {
                  mainImage.src = thumbSrc;
                  mainImage.style.display = 'block';
                  
                  if (mainBlurBg) {
                    mainBlurBg.style.backgroundImage = `url('${thumbSrc}')`;
                  }
                  
                  // Handle global lightbox sync if open
                  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
                  const lightbox = document.getElementById('galleryLightbox') as HTMLElement | null;
                  if (lightboxImg && lightbox && lightbox.classList.contains('active')) {
                    lightboxImg.src = thumbSrc;
                  }

                  const img = new Image();
                  img.onload = () => {
                    if (loadId === currentLoadId) {
                      mainImage.src = fullSrc;
                      if (mainBlurBg) {
                        mainBlurBg.style.backgroundImage = `url('${fullSrc}')`;
                      }
                      if (lightboxImg && lightbox && lightbox.classList.contains('active')) {
                        lightboxImg.src = fullSrc;
                      }
                    }
                  };
                  img.src = fullSrc;
                }
                
                if (mainVideo) mainVideo.style.display = 'none';

                allThumbs.forEach(t => t.classList.remove('active'));
                target.classList.add('active');
                target.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

                if (counter) { counter.textContent = `${currentIndex + 1} / ${imageThumbs.length}`; counter.style.display = 'block'; }
                
                const lightboxCounter = document.getElementById('lightboxCounter') as HTMLElement | null;
                if (lightboxCounter) { lightboxCounter.textContent = `${currentIndex + 1} / ${imageThumbs.length}`; }

                if (prevBtn) prevBtn.style.display = 'flex';
                if (nextBtn) nextBtn.style.display = 'flex';
              };

              // Preload images
              const preloadImages = () => {
                let i = 1;
                const loadNext = () => {
                  if (i < imageThumbs.length) {
                    const img = new Image();
                    img.onload = loadNext;
                    img.onerror = loadNext;
                    img.src = imageThumbs[i].dataset.image!;
                    i++;
                  }
                };
                if (imageThumbs.length > 1) loadNext();
              };
              setTimeout(preloadImages, 500);

              // Setup Global Lightbox Logic (runs once per gallery instance, safe to re-bind because elements replace)
              const lightbox = document.getElementById('galleryLightbox') as HTMLElement | null;
              const lightboxClose = document.getElementById('lightboxClose') as HTMLElement | null;
              const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
              const lightboxPrev = document.getElementById('lightboxPrev') as HTMLButtonElement | null;
              const lightboxNext = document.getElementById('lightboxNext') as HTMLButtonElement | null;
              const lightboxCounter = document.getElementById('lightboxCounter') as HTMLElement | null;

              const openLightbox = () => {
                if (lightbox && lightboxImg && mainImage) {
                  lightboxImg.src = mainImage.src;
                  if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${imageThumbs.length}`;
                  lightbox.classList.add('active');
                  document.body.style.overflow = 'hidden';
                }
              };

              const closeLightbox = () => {
                if (lightbox) {
                  lightbox.classList.remove('active');
                  document.body.style.overflow = '';
                }
              };

              if (expandBtn) expandBtn.addEventListener('click', openLightbox);
              if (mainImage) {
                mainImage.addEventListener('click', openLightbox);
                mainImage.style.cursor = 'pointer';
              }

              // Event listeners bind directly to this gallery scope, so they work after ViewTransitions
              allThumbs.forEach(thumb => {
                thumb.addEventListener('click', () => {
                  allThumbs.forEach(t => t.classList.remove('active'));
                  thumb.classList.add('active');

                  if (thumb.dataset.type === 'video') {
                    if (mainImage) mainImage.style.display = 'none';
                    if (mainVideo) mainVideo.style.display = 'block';
                    if (prevBtn) prevBtn.style.display = 'none';
                    if (nextBtn) nextBtn.style.display = 'none';
                    if (counter) counter.style.display = 'none';
                  } else {
                    goToImage(parseInt(thumb.dataset.index || '0'));
                  }
                });
              });

              prevBtn?.addEventListener('click', () => goToImage(currentIndex - 1));
              nextBtn?.addEventListener('click', () => goToImage(currentIndex + 1));

              // Attach Lightbox global listeners only if not already attached (or re-attach safely)
              if (lightbox && !lightbox.hasAttribute('data-initialized')) {
                lightbox.setAttribute('data-initialized', 'true');
                
                lightbox.addEventListener('click', (e) => {
                  const target = e.target as HTMLElement;
                  if (!target.closest('.lightbox-arrow') && !target.closest('.lightbox-close')) {
                    closeLightbox();
                  }
                });
                
                lightboxPrev?.addEventListener('click', (e) => { e.stopPropagation(); goToImage(currentIndex - 1); });
                lightboxNext?.addEventListener('click', (e) => { e.stopPropagation(); goToImage(currentIndex + 1); });
                
                document.addEventListener('keydown', (e) => {
                  if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
                  if (lightbox.classList.contains('active')) {
                    if (e.key === 'ArrowLeft') goToImage(currentIndex - 1);
                    else if (e.key === 'ArrowRight') goToImage(currentIndex + 1);
                    else if (e.key === 'Escape') closeLightbox();
                  }
                });
              }
            }
          }
          customElements.define('image-gallery', ImageGallery);
        </script>

        <!-- Key Features -->
        <div class="features-grid">
          <div class="feature-item">
            <span class="feature-label">Superficie Total</span>
            <span class="feature-value">{property.area} m²</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Dormitorios</span>
            <span class="feature-value">{property.bedrooms}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Baños</span>
            <span class="feature-value">{property.bathrooms}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Estacionamientos</span>
            <span class="feature-value">{property.parking}</span>
          </div>
          <div class="feature-item">
            <span class="feature-label">Bodegas</span>
            <span class="feature-value">{property.storage}</span>
          </div>
        </div>

        <!-- Description -->
        <div class="description-section">
          <h3>Descripción</h3>
          <div class="description-content">
            {property.description ? <PortableText value={property.description} /> : <p>Sin descripción.</p>}
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="property-sidebar" id="contacto">
        <ContactForm />
      </aside>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="galleryLightbox">
    <div class="lightbox-overlay" id="lightboxOverlay"></div>
    <button class="lightbox-close" id="lightboxClose" aria-label="Cerrar">&times;</button>
    
    <button class="lightbox-arrow lightbox-prev" id="lightboxPrev" aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <div class="lightbox-content">
      <img src="" alt="Imagen ampliada" class="lightbox-img" id="lightboxImg" />
      <div class="lightbox-counter" id="lightboxCounter">1 / 1</div>
    </div>

    <button class="lightbox-arrow lightbox-next" id="lightboxNext" aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</Layout>

<style>
  .property-detail-container {
    padding: var(--space-8) var(--space-4);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .detail-header {
    margin-bottom: var(--space-8);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .header-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .header-main h1 {
    font-size: 2rem;
    margin: var(--space-2) 0;
  }

  @media (min-width: 768px) {
    .header-main h1 {
      font-size: 2.5rem;
    }
  }

  .address {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .badge {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: white;
  }

  .badge.arriendo { background-color: var(--color-accent); }
  .badge.venta { background-color: var(--color-success); }
  .badge.type { background-color: var(--color-primary-dark); }

  .header-price {
    text-align: left;
  }

  @media (min-width: 768px) {
    .header-price {
      text-align: right;
    }
  }

  .header-price h2 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin: 0;
  }

  .expenses {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: var(--space-1);
  }

  .main-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .main-content {
      grid-template-columns: 2fr 1fr;
    }
  }

  .property-info {
    min-width: 0; /* Fix grid blowout */
  }

  .gallery {
    margin-bottom: var(--space-8);
    min-width: 0;
  }

  .main-display-wrapper {
    position: relative;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-primary-dark);
    aspect-ratio: 16/9; /* Wrapper maintains aspect ratio */
  }

  .main-image-blur-bg {
    position: absolute;
    inset: -10%; /* extend past edges to hide the hard edges of the blur vignette */
    width: 120%;
    height: 120%;
    background-size: cover;
    background-position: center;
    filter: blur(20px);
    opacity: 0.5;
    z-index: 0;
    transition: background-image var(--transition-fast);
  }

  .main-image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.45);
    color: white;
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
    z-index: 10;
    backdrop-filter: blur(4px);
  }

  .gallery-arrow:hover {
    background: rgba(0, 0, 0, 0.7);
    transform: translateY(-50%) scale(1.1);
  }

  .gallery-arrow-prev { left: var(--space-3); }
  .gallery-arrow-next { right: var(--space-3); }

  .gallery-counter {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background: rgba(0, 0, 0, 0.5);
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    backdrop-filter: blur(4px);
  }

  .gallery-expand {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: rgba(0, 0, 0, 0.45);
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
    z-index: 10;
    backdrop-filter: blur(4px);
  }

  .gallery-expand:hover {
    background: rgba(0, 0, 0, 0.7);
    transform: scale(1.1);
  }

  /* ── Thumbnail row ── */
  .thumbnail-row {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-2); /* espacio para scrollbar en desktop */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .thumbnail {
    flex: 0 0 22%;   /* ~4 visibles en desktop */
    min-width: 80px;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: var(--radius-md);
    cursor: pointer;
    scroll-snap-align: start;
    transition: opacity var(--transition-fast), outline var(--transition-fast);
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  @media (max-width: 600px) {
    .thumbnail {
      flex: 0 0 38%; /* ~2.5 visibles en móvil */
    }
  }

  .thumbnail:hover { opacity: 0.8; }

  .thumbnail.active {
    outline-color: var(--color-accent);
    opacity: 1;
  }

  .video-thumbnail {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    cursor: pointer;
    flex: 0 0 22%;
    min-width: 80px;
    aspect-ratio: 4/3;
    scroll-snap-align: start;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  @media (max-width: 600px) {
    .video-thumbnail { flex: 0 0 38%; }
  }

  .video-thumbnail.active {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .video-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  }

  .video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    transition: background var(--transition-fast);
  }

  .video-thumbnail:hover .video-play-overlay { background: rgba(0, 0, 0, 0.35); }
  .video-thumbnail:hover { opacity: 0.9; transform: scale(1.03); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .feature-label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .feature-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .video-section {
